configuration { modi: "drun,run,window"; font: "JetBrains Mono 11"; show-icons: true; terminal: "kitty"; }
* { bg: #1e1e1eee; bg-alt: #121212; fg: #e6e6e6; ac: #89b4fa; background-color: @bg; text-color: @fg; border-radius: 8px; }
window { width: 40%; location: center; anchor: center; padding: 10px; }
element { padding: 8px; border-radius: 4px; }
element selected { background-color: @ac; text-color: @bg; }
